      "helpUrl": "https://github.com/chraetenlategan/excel-recon-addin",
      "result": { "dimensionality": "scalar", "type": "string" },
      "options": { "volatile": true },
      "parameters": [
        { "name": "amount", "description": "The amount to match.", "type": "any" },
        { "name": "date", "description": "The date to match.", "type": "any" },
        { "name": "description", "description": "The description text (optional).", "type": "any", "optional": true },
        { "name": "sheetName", "description": "Target sheet name (optional; auto-detected if omitted).", "type": "string", "optional": true }
      ]
    },
